// Data model ของหมากสี่กระดาน — โครงตาม §33 ของ concept
//
// เกมยังเล่นได้โดยไม่ต้องมี database (ถ้าไม่ตั้ง DATABASE_URL จะใช้ NullStore)
// ฐานข้อมูลมีไว้เก็บสิ่งที่ควรอยู่ข้ามการรีสตาร์ต: ตัวตนผู้เล่น, ผลการแข่ง
// และประวัติการเดินทุกเทิร์นสำหรับ replay / match history / anti-cheat

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// ผู้เล่นหนึ่งคน — guest มีแค่ id กับชื่อ ส่วน kind = "user" คือบัญชีที่สมัครไว้
model Player {
  id           String        @id
  name         String
  kind         String        @default("guest")
  /// ชื่อเรียกที่ไม่ซ้ำกัน ใช้ล็อกอินได้เหมือนอีเมล
  username     String?       @unique
  /// อีเมลหลักที่ใช้ล็อกอินและยืนยันตัวตน
  email        String?       @unique
  /// ยืนยันอีเมลแล้วเมื่อไร — null คือยังไม่ยืนยัน
  emailVerifiedAt DateTime?
  /// sub ของบัญชี Google ที่ผูกไว้
  googleId     String?       @unique
  /// argon2id จาก Bun.password — ไม่เคยเก็บรหัสผ่านดิบ
  /// บัญชีที่สมัครผ่าน Google อย่างเดียวจะไม่มีค่านี้
  passwordHash String?
  rating       Int           @default(1200)
  gamesPlayed  Int           @default(0)
  wins         Int           @default(0)
  losses       Int           @default(0)
  draws        Int           @default(0)
  createdAt    DateTime      @default(now())
  lastSeenAt   DateTime      @default(now())
  seats        MatchPlayer[]
  sentRequests     Friendship[] @relation("FriendRequester")
  receivedRequests Friendship[] @relation("FriendAddressee")

  @@index([lastSeenAt])
  @@index([kind, rating])
}

/// ความเป็นเพื่อนหนึ่งคู่ เก็บแถวเดียวไม่ว่าจะมองจากฝั่งไหน
/// ทิศทางบอกว่าใครเป็นคนขอ ซึ่งจำเป็นตอนที่คำขอยังไม่ถูกตอบรับ
model Friendship {
  id          String    @id @default(uuid())
  requester   Player    @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String
  addressee   Player    @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  addresseeId String
  /// pending | accepted
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// รหัส OTP สำหรับยืนยันอีเมล — เก็บเฉพาะแฮช ไม่เคยเก็บรหัสดิบ
model OtpCode {
  id        String   @id @default(uuid())
  /// อีเมลปลายทาง เก็บเป็นตัวพิมพ์เล็กเสมอ
  email     String
  codeHash  String
  /// verify_email | reset_password
  purpose   String   @default("verify_email")
  expiresAt DateTime
  /// นับครั้งที่กรอกผิด กันเดารหัส 6 หลักด้วยการยิงรัว
  attempts  Int      @default(0)
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model Match {
  id          String        @id
  status      String        @default("active")
  /// ที่มาของ match: quick | room | challenge | ai
  source      String
  playerCount Int
  turnSeconds Int
  turns       Int           @default(0)
  /// นับคะแนน rating หรือไม่ — จริงเฉพาะเมื่อทุกที่นั่งเป็นบัญชีที่สมัครแล้ว
  rated       Boolean       @default(false)
  /// เหตุผลที่เกมจบ ตาม EndReason ของ engine
  reason      String?
  /// snapshot ของ GameState ล่าสุดเป็น JSON ใช้ตรวจสอบย้อนหลังและกู้เกมได้
  state       String?
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  players     MatchPlayer[]
  actions     MatchAction[]

  @@index([status, startedAt])
}

/// ที่นั่งหนึ่งที่นั่งในหนึ่ง match — เก็บชื่อ ณ เวลานั้นไว้ด้วย เพราะผู้เล่นเปลี่ยนชื่อได้
model MatchPlayer {
  id       String  @id @default(uuid())
  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId  String
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerId String?
  seat     Int
  name     String
  isBot    Boolean @default(false)
  botLevel String?
  score        Int     @default(0)
  retired      Boolean @default(false)
  winner       Boolean @default(false)
  ratingBefore Int?
  ratingAfter  Int?

  @@unique([matchId, seat])
  @@index([playerId])
}

/// หนึ่งเทิร์นที่เล่นไปแล้ว — พอที่จะ replay ทั้งเกมได้จากกระดานเริ่มต้น
model MatchAction {
  id        String   @id @default(uuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  turn      Int
  seat      Int
  pieceId   Int
  /// capture | move
  kind      String
  /// เส้นทางที่หมากเดิน เป็น JSON array ของ index ช่อง
  path      String
  captures  Int
  createdAt DateTime @default(now())

  @@unique([matchId, turn])
  @@index([matchId])
}
