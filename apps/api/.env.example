# ตัวอย่างค่าตั้งของ backend — คัดลอกเป็น .env แล้วแก้ตามจริง
#
#   cp .env.example .env
#
# ไฟล์ .env ถูก .gitignore ไว้แล้ว ห้าม commit
# ค่าที่ไม่มีในไฟล์นี้จะใช้ค่าเริ่มต้นใน config.py ซึ่งเหมาะกับตอนพัฒนาเท่านั้น
# ทุกค่าที่ต้องตั้งใน production ถูกบังคับให้ตั้งโดย ENVIRONMENT=production

# ── ระบบ ──────────────────────────────────────────────────────────────────

# development | staging | production
# ตั้งเป็น production เพื่อให้แอปบังคับค่าที่ขาดหายและปฏิเสธค่าที่ไม่ปลอดภัย
ENVIRONMENT=development

# URL ที่ผู้ใช้เห็นจริง ใช้สร้างลิงก์เชิญเข้าห้อง
PUBLIC_URL=http://localhost:8000

# origin ที่อนุญาตให้เรียก API คั่นด้วยจุลภาค
# ค่าเริ่มต้นคือ * ซึ่ง production จะปฏิเสธเพราะเปิดให้ทุก origin
CORS_ORIGINS=*

# ── ฐานข้อมูล ────────────────────────────────────────────────────────────

# ไม่ตั้ง = เล่นได้ครบทุกอย่าง แต่ไม่มีบัญชีผู้ใช้ ไม่มีอันดับ และไม่เก็บประวัติ
DATABASE_URL=sqlite+aiosqlite:///./mak-thai.db

# production ต้องปิดไว้แล้วใช้ alembic upgrade head แทน
# เพราะ create_all ไม่แก้ตารางที่มีอยู่แล้วเมื่อสคีมาเปลี่ยน ของเก่าจะพังเงียบ ๆ ตอนรันจริง
AUTO_CREATE_TABLES=true

# ── คลัสเตอร์หลายเครื่อง ──────────────────────────────────────────────────

# ไม่ตั้ง = ทำงานแบบ node เดียว
REDIS_URL=
# ชื่อโหนดในคลัสเตอร์ — ไม่ตั้งก็สุ่มให้ตอนเริ่ม
NODE_ID=
# แยกวงคุยเมื่อหลายสภาพแวดล้อมใช้ Redis ตัวเดียวกัน
# เพราะช่อง pub/sub ของ Redis ไม่แยกตามฐานข้อมูล
CLUSTER_PREFIX=makthai

# ── ตัวตนผู้เล่น ──────────────────────────────────────────────────────────

# ใช้เซ็น token และเซสชัน ทุก node ต้องใช้ค่าเดียวกัน
# ไม่ตั้งหรือสั้นกว่า 16 ตัวอักษร = สุ่มใหม่ทุกครั้งที่รีสตาร์ต
# ผู้เล่นจะหลุดตัวตน และหลาย node จะตรวจ token ของกันไม่ได้ — production บังคับให้ตั้ง
AUTH_SECRET=

# วินาทีต่อเทิร์น 0 = ไม่มีนาฬิกา
TURN_SECONDS=45

# อายุเซสชัน (วัน) ผู้เล่นที่สมัครบัญชี
SESSION_TTL_DAYS=30
# อายุเซสชันของผู้เล่นชั่วคราว (นาที) สั้นกว่าเพราะไม่มีอะไรให้เสียหาย
GUEST_SESSION_TTL_MINUTES=720

# ── อีเมล ─────────────────────────────────────────────────────────────────

# ไม่ตั้งทั้ง smtp และ webhook = พิมพ์รหัสยืนยันลงบันทึกให้เห็นตอนพัฒนา
# เปิดกล่องจดหมายทดสอบด้วย pnpm mail แล้วตั้ง SMTP_HOST=localhost
MAIL_FROM="หมากไทย <no-reply@mak-thai.local>"
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=false

# ช่องทางอีกแบบ — ยิง webhook ตรง ๆ ไม่ต้องผ่าน SMTP
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=

# ── Google ────────────────────────────────────────────────────────────────

# client id ทุกตัวที่ใช้ คั่นด้วยจุลภาค (เว็บ ไอโอเอส แอนดรอยด์)
GOOGLE_CLIENT_IDS=
# client id ของฝั่งเว็บ ใช้เริ่ม Google Identity Services ในเบราว์เซอร์
# ต้องอยู่ใน GOOGLE_CLIENT_IDS ด้วย ไม่งั้นปุ่มล็อกอินจะไม่โผล่
GOOGLE_WEB_CLIENT_ID=