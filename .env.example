# ค่าตั้งของระบบที่กำลัง deploy — คัดลอกเป็น .env แล้วแก้
#
#   cp .env.example .env
#
# .env ถูก .gitignore ไว้แล้ว ห้าม commit
# ค่าที่ไม่มีในไฟล์นี้จะใช้ค่าเริ่มต้นใน config.py ซึ่งเหมาะกับตอนพัฒนาเท่านั้น
# ใน production ค่าที่ขาดจะทำให้แอปไม่ยอมเริ่ม พร้อมบอกรายการที่ขาดทั้งหมด

# ── ตัวตนต่อระบบ ────────────────────────────────────────────────────────────

# อย่างน้อย 32 ตัวอักษร และต้องเหมือนกันทุกโหนด ไม่งั้น token ข้ามเครื่องไม่ผ่าน
# สร้างด้วย: openssl rand -hex 32
AUTH_SECRET=

# ที่อยู่ที่ผู้ใช้เปิด ใช้สร้างลิงก์เชิญเข้าห้อง ต้องเป็น https
# ถ้ามี reverse proxy ข้างหน้าให้ใส่ที่นั้น ไม่ใช่ที่อยู่ของคอนเทนเนอร์
PUBLIC_URL=https://mak-thai.example

# origin ที่อนุญาตให้เรียก API คั่นด้วยจุลภาค ห้ามใช้ * ใน production
# ใส่ทั้งเว็บและที่อยู่แอปมือถือถ้ามี
CORS_ORIGINS=https://mak-thai.example

# ชื่อเว็บ
WEB_BIND=127.0.0.1

# อายุเซสชันของบัญชีเป็นวัน หลังหมดอายุต้องล็อกอินใหม่
SESSION_TTL_DAYS=30

# วินาทีต่อเทิร์น 0 = ไม่มีนาฬิกา
TURN_SECONDS=45

# จำนวนสายที่คนหนึ่งคนเปิดพร้อมกันได้
MAX_CONNECTIONS_PER_PEER=8
# จำนวนสายที่โหนดหนึ่งรับได้พร้อมกัน ตั้งให้พอดีกับขนาดเครื่อง
MAX_CONNECTIONS_TOTAL=10000

# ── ฐานข้อมูล ────────────────────────────────────────────────────────────

POSTGRES_USER=makthai
POSTGRES_PASSWORD=
POSTGRES_DB=makthai

# ── คลัสเตอร์ ────────────────────────────────────────────────────────────

# ต้องต่างกันถ้าหลายสภาพแวดล้อมใช้ Redis ตัวเดียวกัน
# เพราะช่อง pub/sub ของ Redis ไม่แยกตามฐานข้อมูล
CLUSTER_PREFIX=makthai

# ชื่อโหนด ต้องไม่ซ้ำกัน ไม่งั้นผลลัพธ์จะทับกัน
# compose ตั้งให้แล้วเป็น api1 และ api2 แก้เฉพาะถ้ารันเอง
NODE_ID_1=api1
NODE_ID_2=api2

# ── อีเมล ─────────────────────────────────────────────────────────────────

# ต้องตั้งอย่างใดอย่างหนึ่ง หรือรหัสยืนยันจะไม่ถึงผู้ใช้
MAIL_FROM="หมากไทย <no-reply@mak-thai.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=true

# ── Google ────────────────────────────────────────────────────────────────

# client id ทุกตัวที่ใช้ คั่นด้วยจุลภาค
GOOGLE_CLIENT_IDS=
# client id ฝั่งเว็บ ต้องอยู่ในรายการข้างบนด้วย
GOOGLE_WEB_CLIENT_ID=
