# ── พื้นฐาน ────────────────────────────────────────────────────────────────
PORT=3000
TURN_SECONDS=45
# URL ที่ผู้เล่นเห็นจริง ใช้สร้างลิงก์เชิญ
PUBLIC_URL="http://localhost:3000"

# ── ฐานข้อมูล ──────────────────────────────────────────────────────────────
# ไม่ตั้งก็เล่นได้ครบ แค่ไม่มีบัญชีผู้ใช้ ไม่มี ranking และไม่เก็บประวัติ
DATABASE_URL="file:./dev.db"

# ── บัญชีผู้ใช้ ─────────────────────────────────────────────────────────────
# ใช้เซ็น token ของทั้ง guest และบัญชีที่สมัคร ต้องยาวอย่างน้อย 16 ตัว
# ทุก node ต้องใช้ค่าเดียวกัน ไม่งั้นตัวตนจะข้ามเครื่องไม่ได้
AUTH_SECRET="เปลี่ยนค่านี้ให้เป็นความลับที่ยาวและสุ่มจริง"

# ── อีเมล (สำหรับ OTP ยืนยันบัญชี) ──────────────────────────────────────────
# ไม่ตั้ง = พิมพ์รหัสลง console ให้เห็นตอน dev
# MAIL_WEBHOOK_URL="https://example.com/send-mail"
# MAIL_WEBHOOK_TOKEN="..."

# ── ล็อกอินด้วย Google ─────────────────────────────────────────────────────
# ใส่ client id ทุกตัวที่ใช้ คั่นด้วย comma (เว็บ, iOS, Android)
# GOOGLE_CLIENT_IDS="xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com"
# GOOGLE_WEB_CLIENT_ID="xxx.apps.googleusercontent.com"

# ── client ข้ามแพลตฟอร์ม ───────────────────────────────────────────────────
# origin ที่อนุญาต คั่นด้วย comma ("*" = ทุก origin)
CORS_ORIGINS="*"

# ── หลาย node ──────────────────────────────────────────────────────────────
# ตั้งสามตัวนี้เมื่อรันมากกว่าหนึ่ง node เท่านั้น
# REDIS_URL="redis://localhost:6379"
# NODE_ID="node-a"
# NODE_URL="https://a.game.example.com"
